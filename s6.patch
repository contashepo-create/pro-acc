+
+function authedRequest(body?: any, method = 'POST') {
+  const token = createToken('u1', 'admin');
+  return {
+    url: 'http://localhost/api/test',
+    method,
+    headers: { get: (k: string) => (k === 'authorization' ? `Bearer ${token}` : null) },
