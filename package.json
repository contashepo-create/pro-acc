{
  "name": "accweb",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "jest --verbose",
    "test:unit": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage --coverageReporters=text --coverageReporters=json-summary",
    "test:watch": "jest --watch",
    "test:integration": "jest src/__tests__/comprehensive-integration.test.ts --runInBand",
    "test:regression": "jest --runInBand",
    "migrate": "npx tsx src/migrations/run.ts",
    "test:migrations": "node scripts/test-migrations.mjs",
    "test:migrations:pg": "MIGRATION_DRIVER=postgres node scripts/test-migrations.mjs",
    "seed": "npx tsx scripts/seed.ts",
    "audit:fuzz": "npx tsx scripts/audit-fuzz.mts",
    "audit:db": "MIGRATION_DRIVER=postgres node scripts/audit-live-db.mjs",
    "schema:generate": "node scripts/generate-full-schema.mjs",
    "test:db": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testMatch=\"**/*.db.test.ts\" --testPathIgnorePatterns=\"[]\" --verbose",
    "test:ui": "jest -c jest.ui.config.js --runInBand",
    "test:ui:coverage": "jest -c jest.ui.config.js --runInBand --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@supabase/supabase-js": "^2.108.2",
    "@tanstack/react-query": "^5.101.0",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "framer-motion": "^12.40.0",
    "jsbarcode": "^3.12.3",
    "lucide-react": "^1.21.0",
    "next": "16.3.0",
    "nodemailer": "^9.0.3",
    "pg": "^8.22.0",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.5",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/jest": "^30.0.0",
    "@types/jsbarcode": "^3.11.4",
    "@types/node": "^20.19.43",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.9",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "tailwindcss": "^4.3.3",
    "ts-jest": "^29.4.11",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@emnapi/wasi-threads": "1.2.3"
  }
}
