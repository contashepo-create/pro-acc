+        const row = applyFilters()[0] ?? null;
+        return { data: row, error: row ? null : { message: 'not found' } };
+      },
+      then: (onF: any, onR: any) =>
+        Promise.resolve({ data: applyFilters(), error: null }).then(onF, onR),
+    };
+    return api;
+  };
